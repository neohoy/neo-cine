[
 {
  "i": 0,
  "start": 10.42,
  "end": 14.5,
  "text": "东门城的影子落在傍晚"
 },
 {
  "i": 1,
  "start": 14.82,
  "end": 19.3,
  "text": "机车穿过巷口的灯盏"
 },
 {
  "i": 2,
  "start": 19.6,
  "end": 23.0,
  "text": "城隍庙的香气绕过衣衫"
 },
 {
  "i": 3,
  "start": 23.38,
  "end": 28.78,
  "text": "一碗米粉暖着下课的晚餐"
 },
 {
  "i": 4,
  "start": 29.26,
  "end": 33.48,
  "text": "单车沿着校园慢慢转弯"
 },
 {
  "i": 5,
  "start": 33.78,
  "end": 38.44,
  "text": "风把笑声吹得很远很满"
 },
 {
  "i": 6,
  "start": 38.76,
  "end": 42.24,
  "text": "我们说未来藏在哪一站"
 },
 {
  "i": 7,
  "start": 42.48,
  "end": 48.0,
  "text": "却先把名字写进夜色里面"
 },
 {
  "i": 8,
  "start": 48.46,
  "end": 53.02,
  "text": "园区的窗还亮着一片"
 },
 {
  "i": 9,
  "start": 53.44,
  "end": 57.52,
  "text": "有人为明天留在今天"
 },
 {
  "i": 10,
  "start": 57.78,
  "end": 61.42,
  "text": "公路尽头的海正召唤"
 },
 {
  "i": 11,
  "start": 61.68,
  "end": 66.0,
  "text": "风替每个远方说晚安"
 },
 {
  "i": 12,
  "start": 66.5,
  "end": 68.12,
  "text": "风吹新竹啊"
 },
 {
  "i": 13,
  "start": 68.12,
  "end": 70.0,
  "text": "也吹过我们的年少啊"
 },
 {
  "i": 14,
  "start": 70.68,
  "end": 72.92,
  "text": "从东门城到海岸啊"
 },
 {
  "i": 15,
  "start": 72.92,
  "end": 75.0,
  "text": "每一步都有回家的光啊"
 },
 {
  "i": 16,
  "start": 76.08,
  "end": 77.72,
  "text": "风吹新竹啊"
 },
 {
  "i": 17,
  "start": 77.72,
  "end": 80.0,
  "text": "把漂泊吹成了牵挂啊"
 },
 {
  "i": 18,
  "start": 80.24,
  "end": 83.42,
  "text": "夜里亮起的千万扇窗啊"
 },
 {
  "i": 19,
  "start": 83.42,
  "end": 86.6,
  "text": "原来我们都在这里长大"
 },
 {
  "i": 20,
  "start": 87.44,
  "end": 89.3,
  "text": "科学园区的楼还没暗"
 },
 {
  "i": 21,
  "start": 89.54,
  "end": 91.7,
  "text": "咖啡杯映着凌晨的答案"
 },
 {
  "i": 22,
  "start": 92.04,
  "end": 93.8,
  "text": "有人赶着简报和预算"
 },
 {
  "i": 23,
  "start": 94.08,
  "end": 96.5,
  "text": "有人想念宿舍门前的晚安"
 },
 {
  "i": 24,
  "start": 96.72,
  "end": 98.9,
  "text": "十七公里的风越过栏杆"
 },
 {
  "i": 25,
  "start": 99.12,
  "end": 101.3,
  "text": "吹散了口袋里旧车票一张"
 },
 {
  "i": 26,
  "start": 101.52,
  "end": 103.1,
  "text": "海边公路把心事拉长"
 },
 {
  "i": 27,
  "start": 103.44,
  "end": 106.96,
  "text": "我们在浪声里练习不慌张"
 },
 {
  "i": 28,
  "start": 107.28,
  "end": 108.88,
  "text": "风吹新竹啊"
 },
